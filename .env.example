# =============================================================================
# Content Factory — environment variables
# Copy to .env and fill in values. Never commit .env.
#
# ZERO-COST DEFAULT: leave paid keys empty, install Ollama, use:
#   python run.py --profile free --mode core --topic "..." --auto-approve
# =============================================================================

# --- Provider selection ---
# LLM: auto | ollama_cloud | ollama | xai | openai_compatible | none
LLM_PROVIDER=auto
# Search: auto | duckduckgo | tavily | serper | brave | none
SEARCH_PROVIDER=auto
# TTS: auto | edge | piper | elevenlabs | none
TTS_PROVIDER=auto
CHUNKED_SCRIPT=true
DEFAULT_PROFILE=free

# --- Free: Ollama Cloud (recommended — free session/weekly tier) ---
# Create key: https://ollama.com/settings/keys
# Official env name (preferred):
OLLAMA_API_KEY=
# Or:
# OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# Smaller models stretch free quota further
OLLAMA_CLOUD_MODEL=gpt-oss:20b

# --- Free local Ollama (optional fallback / offline) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_LOCAL_API_KEY=ollama

# --- Free TTS (edge-tts; no API key) ---
# RyanNeural + slightly slower rate + SSML breaks = clearer, less robotic VO
EDGE_TTS_VOICE=en-GB-RyanNeural
EDGE_TTS_RATE=-8%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_USE_SSML=true
# PIPER_MODEL_PATH=   # optional offline TTS

# --- Paid LLM (optional upgrade later) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# Optional OpenAI-compatible free tiers (Groq, etc.) when you have a free key
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- Paid search (optional; free DuckDuckGo used without these) ---
TAVILY_API_KEY=
# SERPER_API_KEY=
# BRAVE_API_KEY=

# --- X / Twitter (optional) ---
X_BEARER_TOKEN=

# --- Paid voice (optional upgrade) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- YouTube Data API / OAuth — free Google Cloud project, optional ---
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_CREDENTIALS_PATH=data/cache/youtube_credentials.json
YOUTUBE_CHANNEL_ID=

# --- Mobile remote control API (Phase F3; free local server) ---
CONTROL_API_TOKEN=dev-local-token
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=8787

# --- Channel & runtime ---
CHANNEL_NAME=Tech Frontier
DEFAULT_MODE=core
AUTO_APPROVE=false
HEADLESS=false
LOG_LEVEL=INFO
DATA_DIR=data
